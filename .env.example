# No environment variables are required for core local-first product use.
# Configure an optional restricted Gemini API key in Settings for personal use.

# Optional anonymous product telemetry. These are public browser configuration values,
# not user credentials. When VITE_POSTHOG_KEY is omitted, no analytics client runs.
VITE_POSTHOG_KEY=
# Optional host is restricted by the client and CSP to the US PostHog endpoint.
VITE_POSTHOG_HOST=https://us.i.posthog.com
